---
import Container from "../layouts/Container.astro";
import Layout from "../layouts/Layout.astro"
import { SITE_URL } from "../config";
---



<Layout
    title="About Pickleballr | Pickleball Guides and Reviews"
    description="Pickleballr helps 2.5–4.0 rec players choose gear and win more rec and tournament points through evergreen education and living gear pages."
    breadcrumbs={[
        { name: 'Home', url: SITE_URL },
        { name: 'About', url: `${SITE_URL}/about` },
    ]}
    jsonLd={{
        '@context': 'https://schema.org',
        '@type': 'AboutPage',
        name: 'About Pickleballr',
        description: 'Pickleballr helps 2.5–4.0 rec players choose gear and win more rec and tournament points through evergreen education and living gear pages.',
        url: 'https://www.pickleballr.io/about',
    }}
>
    <Container>
        <div class="pt-20 py-10">
            <!-- <h1 class="text-5xl md:text-6xl font-bold text-center ">About Pickleball<span class="text-lime-400">r</span>.</h1>
            <div class="pt-10">
                <img src={`./images/placeholder-hero.jpg`} class="object-contain w-full "/>
            </div> -->
            <section class="flex flex-col gap-2 px-4 py-20 text-center bg-pink-500">
                <h1 class="text-5xl sm:text-7xl md:text-8xl font-bold text-zinc-50">Pickleball<span class="text-lime-400">r</span>.</h1>
            </section>
        </div>
        <section>
            <div class="text-base md:text-xl flex flex-col gap-4 pb-16">
                <p>
                    Pickleballr helps 2.5–4.0 rec players choose gear and win more rec and tournament points.
                    We focus on three things: evergreen education, living gear pages, and one tool later.
                </p>
                <p>
                    Carson Richter, a rec and tournament pickleball writer and former tennis player based in Scottsdale,
                    writes the site. We are former tennis players who learned to love pickleball and want to share
                    what actually helps on the rec court — paddle reviews, strategy, and technique.
                </p>
                <p>
                    Read more about Carson on the <a href="/authors/carson-richter" class="text-green-600 underline hover:text-pink-500">author page</a>.
                </p>
            </div>
        </section>
    </Container>
</Layout>
