---
import Layout from '../layouts/Layout.astro';
import { getBlogPosts } from '../utils/blogPosts';
import Container from '../layouts/Container.astro';
import PostCard from '../components/PostCard.astro';

// Load all posts, then sort them by date.
const posts = getBlogPosts();
---

<Layout
	title="Pickleball Blog | Pickleballr"
	description="Pickleball articles on rules, paddle reviews, ratings, serving, and strategy from Pickleballr."
>
	<Container>
		<main>
			<section class="py-10">
				<ul class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</ul>
			</section>
		</main>
	</Container>
</Layout>
