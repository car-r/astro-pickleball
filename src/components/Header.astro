---
import HeaderLink from './HeaderLink.astro';
---
<header class="py-3 sticky top-0 z-50 bg-zinc-900 text-zinc-50 shadow-sm">
	<nav class="hidden md:flex items-center justify-between max-w-4xl mx-auto text-sm md:text-base">
		<div><a href="/" class="text-2xl font-bold  ml-2">Pickleball<span class="text-lime-400">r</span>.</a></div>
		<div class="flex gap-1 font-semibold">
			<HeaderLink href="/blog" class="">Blog</HeaderLink>
			<HeaderLink href="/tools" class="">Tools</HeaderLink>
			<HeaderLink href="/about" class="">About</HeaderLink>
			<HeaderLink href="/contact" class="">Contact</HeaderLink>
			<HeaderLink href="https://twitter.com/pickleballrio" target="_blank" class="text-white hover:text-blue-400">Twitter</HeaderLink>
		</div>
	</nav>
	<div class="md:hidden flex justify-between px-4">
		<div><a href="/" class="text-2xl font-bold  ml-2">Pickleball<span class="text-lime-400">r</span>.</a></div>
		<button type="button" id="menu-toggle" class="w-6 h-6 text-zinc-50" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
			<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
				<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
			</svg>
		</button>
	</div>
	<nav id="mobile-menu" class="hidden pt-4 w-48">
		<ul class="flex flex-col gap-2 px-6">
			<HeaderLink href="/blog" class="">Blog</HeaderLink>
			<HeaderLink href="/tools" class="">Tools</HeaderLink>
			<HeaderLink href="/about" class="">About</HeaderLink>
			<HeaderLink href="/contact" class="">Contact</HeaderLink>
			<HeaderLink href="https://twitter.com/pickleballrio" target="_blank" class="">Twitter</HeaderLink>
		</ul>
	</nav>
</header>
<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	toggle?.addEventListener('click', () => {
		const isHidden = menu?.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(isHidden === false));
	});
</script>
