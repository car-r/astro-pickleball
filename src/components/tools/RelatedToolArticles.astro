---
interface Props {
	heading?: string;
}

const { heading = 'Related articles' } = Astro.props;
---

<section>
	<h2 class="text-xl font-bold mb-3">{heading}</h2>
	<ul class="flex flex-col gap-2">
		<li>
			<a class="text-green-600 underline hover:text-pink-500" href="/blog/pickleball-ratings">
				Pickleball ratings: how to know your rating
			</a>
		</li>
		<li>
			<a class="text-green-600 underline hover:text-pink-500" href="/blog/dupr-rating">
				DUPR rating
			</a>
		</li>
		<li>
			<a class="text-green-600 underline hover:text-pink-500" href="/blog/how-to-master-3rd-shot-drops-in-pickleball">
				How to master 3rd shot drops in pickleball
			</a>
		</li>
	</ul>
	<p class="mt-4">
		<a
			class="text-green-600 underline hover:text-pink-500"
			href="https://www.dupr.com"
			rel="noopener noreferrer"
		>
			Get a real DUPR
		</a>
		— DUPR only moves when you log real matches.
	</p>
</section>
