---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { DEFAULT_OG_IMAGE, SITE_URL } from "../config";

interface BlogFrontmatter {
	title: string;
	description: string;
	pubDate?: string;
	updatedDate?: string;
	heroImage?: string;
	tags?: string[];
}

export interface Props {
	frontmatter?: BlogFrontmatter;
	content?: BlogFrontmatter;
}

const data = (Astro.props.frontmatter ?? Astro.props.content) as BlogFrontmatter;
const { title, description, pubDate, updatedDate, heroImage } = data;

const site = Astro.site ?? new URL(SITE_URL);
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImage = heroImage || DEFAULT_OG_IMAGE;
const imageURL = new URL(ogImage, site);

const toIsoDate = (value?: string) => {
	if (!value) return undefined;
	const parsed = new Date(value);
	return Number.isNaN(parsed.valueOf()) ? undefined : parsed.toISOString();
};

const articleJsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	image: imageURL.href,
	author: {
		'@type': 'Organization',
		name: 'Pickleballr',
		url: SITE_URL,
	},
	publisher: {
		'@type': 'Organization',
		name: 'Pickleballr',
		url: SITE_URL,
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalURL.href,
	},
};

const datePublished = toIsoDate(pubDate);
const dateModified = toIsoDate(updatedDate) || datePublished;
if (datePublished) articleJsonLd.datePublished = datePublished;
if (dateModified) articleJsonLd.dateModified = dateModified;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} image={ogImage} type="article" jsonLd={articleJsonLd} />
    </head>
    <body class="bg-zinc-100">
        <Header />
        <main class="flex flex-col mx-auto max-w-4xl px-4 py-20">
            <article class="prose max-w-none prose-lg md:prose-lg prose-a:text-green-500  prose-headings:text-zinc-900 prose-strong:text-zinc-800 prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-li:marker:text-zinc-600 prose-img:w-full prose-blockquote:border-lime-400 prose-h2:scroll-mt-16 prose-h3:scroll-mt-16">
                {heroImage && (
					<img
						width={870}
						height={360}
						src={heroImage}
						alt=""
						class=""
					/>
				)}
                <h1 class="text-2xl md:text-4xl font-bold " style="margin: 0">{title}</h1>
                {pubDate && <time class=" text-stone-700">{pubDate}</time>}
				{updatedDate && <div class="text-stone-500 ">Last updated on <time>{updatedDate}</time></div>}
                <slot />
            </article>
        </main>
    </body>
</html>

<style>
    #container {
      position: relative;
      width: 100%;
      overflow: hidden;
      padding-top: 56.25%; /* 16:9 Aspect Ratio */
    }
    
    #responsive-iframe {
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      right: 0;
      width: 100%;
      height: 100%;
      border: none;
    }
</style>
